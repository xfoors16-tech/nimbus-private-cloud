# Copy to .env for local Docker Compose use. Replace every development password.
POSTGRES_DB=privatecloud
POSTGRES_USER=cloud
POSTGRES_PASSWORD=change-this-development-password
DATABASE_URL=postgresql+psycopg://cloud:change-this-development-password@postgres:5432/privatecloud
MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=change-this-minio-password
S3_ACCESS_KEY=minio-local
S3_SECRET_KEY=change-this-minio-password
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=private-cloud
STORAGE_BACKEND=s3
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
DEFAULT_QUOTA_BYTES=2147483648
MAX_UPLOAD_BYTES=104857600
CORS_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
